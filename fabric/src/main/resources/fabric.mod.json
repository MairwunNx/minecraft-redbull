{
  "schemaVersion": 1,
  "id": "redbull",
  "version": "${version}",
  "name": "Red Bull",
  "description": "26 real Red Bull cans in survival: bull bile from cows brews into crude taurine, a furnace evaporates it into taurine, and a crafting table fills a can. Cans with wings let you glide; caffeine builds up, and above 100 the heart gives out.",
  "authors": ["MairwunNx"],
  "contact": {
    "homepage": "https://modrinth.com/mod/minecraft-redbull",
    "sources": "https://github.com/MairwunNx/minecraft-redbull",
    "issues": "https://github.com/MairwunNx/minecraft-redbull/issues"
  },
  "license": "MIT",
  "icon": "assets/redbull/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{ "adapter": "kotlin", "value": "ru.mairwunnx.redbull.fabric.RedBullMod" }]
  },
  "mixins": ["redbull.mixins.json", "redbull.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${kotlin}",
    "minecraft": "~${minecraft}",
    "java": ">=25"
  }
}
